# zapret (nfqws) только для YouTube и Discord. %i — slug стратегии из /opt/zapret-dy/strategies.
#
# Секции [Install] нет намеренно: юнит нельзя включить в автозагрузку,
# он запускается только вручную (кнопкой в zapret-toggle через polkit).
[Unit]
Description=zapret DPI bypass for YouTube and Discord (strategy %i)
Documentation=https://github.com/bol-van/zapret
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=/opt/zapret-dy/firewall.sh up %i
ExecStart=/opt/zapret-dy/run.sh %i
# Выполняется всегда, в том числе после падения nfqws или ошибки ExecStartPre.
ExecStopPost=/opt/zapret-dy/firewall.sh down
Restart=on-failure
RestartSec=2

# Песочница: nfqws разбирает чужие пакеты из сети, поэтому ему оставлено только нужное —
# netlink (nft, очередь), raw-сокеты и чтение /opt/zapret-dy. Писать на диск некуда (кроме
# своего /tmp), новых привилегий и пространств имён не получить.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID
NoNewPrivileges=yes
UMask=0077
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute нельзя: бинарник nfqws упакован и при старте делает свою память
# исполняемой (mprotect) — с этим запретом он падает с SIGSEGV.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
